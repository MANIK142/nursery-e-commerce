@model Nursery.Web.Host.Models.ViewModels.ConfirmationViewModel
@using System.Globalization
@using Nursery.Web.Host.Models.DTOs.Orders
@{
    ViewData["Title"] = "Order confirmation";
    var inr = CultureInfo.GetCultureInfo("en-IN");
    string Money(decimal v) => v.ToString("C2", inr);
    var order = Model.Order;
    var status = order.PaymentStatus;
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        @if (status == OrderStatuses.Paid)
        {
            <div class="text-center mb-4">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 3.5rem;"></i>
                <h2 class="fw-bold mt-2">Thank you, your order is confirmed</h2>
                <p class="text-secondary mb-0">Order <strong>@order.Id</strong>. We'll email you when it ships.</p>
            </div>
        }
        else if (status == OrderStatuses.PendingPayment)
        {
            <div id="pending-state" class="text-center mb-4" role="status" aria-live="polite">
                <div class="spinner-border text-success mb-3" aria-hidden="true"></div>
                <h2 class="fw-bold">Confirming your payment…</h2>
                <p id="pending-text" class="text-secondary mb-0">
                    This usually takes a few seconds. Please don't close this page.
                </p>
            </div>
        }
        else if (status == OrderStatuses.PaymentFailed)
        {
            <div class="text-center mb-4">
                <i class="bi bi-x-circle-fill text-danger" style="font-size: 3.5rem;"></i>
                <h2 class="fw-bold mt-2">Payment didn't go through</h2>
                <p class="text-secondary">You haven't been charged. Your order <strong>@order.OrderNumber</strong> is still saved.</p>
                <a asp-action="Pay" asp-route-orderId="@order.Id" class="btn btn-success">Try payment again</a>
            </div>
        }
        else
        {
            <div class="text-center mb-4">
                <i class="bi bi-info-circle-fill text-secondary" style="font-size: 3.5rem;"></i>
                <h2 class="fw-bold mt-2">This order is @order.Status.ToLowerInvariant()</h2>
                <p class="text-secondary">Order <strong>@order.OrderNumber</strong></p>
            </div>
        }

        <section class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Order details</h5>

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Product</th>
                                <th scope="col" class="text-center">Qty</th>
                                <th scope="col" class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in order.OrderItems)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@i.PlantName @i.ProductNameAtPurchase</div>
                                        <span class="badge text-bg-light border text-secondary">@i.Sku</span>
                                    </td>
                                    <td class="text-center">@i.Quantity</td>
                                    <td class="text-end">@Money(i.LineTotal)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <dl class="d-flex justify-content-between mb-1">
                    <dt class="fw-normal text-secondary">Subtotal</dt>
                    <dd class="mb-0">@Money(order.OrderItems.Sum(i => i.LineTotal))</dd>
                </dl>
                <dl class="d-flex justify-content-between mb-1">
                    <dt class="fw-normal text-secondary">Shipping</dt>
                    <dd class="mb-0">@(order.ShippingFee == 0 ? "Free" : Money(order.ShippingFee))</dd>
                </dl>
                <dl class="d-flex justify-content-between align-items-baseline mb-0">
                    <dt class="fs-5">Total</dt>
                    <dd class="fs-5 fw-bold text-success mb-0">@Money(order.OrderItems.Sum(i => i.LineTotal))</dd>
                </dl>

                @if (order.ShippingAddress is { } a)
                {
                    <hr />
                    <div class="fw-semibold mb-1">Delivering to</div>
                    <div class="text-body-secondary">
                        @a.Line1@(string.IsNullOrWhiteSpace(a.Line2) ? "" : ", " + a.Line2)<br />
                        @a.City, @a.State @a.PostalCode
                    </div>
                }
            </div>
        </section>

        <div class="text-center mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success">Continue shopping</a>
        </div>
    </div>
</div>

@section Scripts {
    @if (status == OrderStatuses.PendingPayment)
    {
        <script>
            (function() {
                // The redirect from Stripe isn't proof of payment; wait for the webhook to flip the order status.
                const statusUrl = '@Url.Action("Status", "Checkout", new { orderId = order.Id })';
                const maxAttempts = 15;   // ~30s at 2s intervals
                let attempts = 0;

                const timer = setInterval(async () => {
                    attempts++;
                    try {
                        const res = await fetch(statusUrl, { headers: { 'Accept': 'application/json' } });
                        if (res.ok) {
                            const { PaymentStatus } = await res.json();
                            console.log("PaymentStatus - " + PaymentStatus);
                            if (status !== '@OrderStatuses.PendingPayment') {
                                clearInterval(timer);
                                location.reload();
                                return;
                            }
                        }
                    } catch { /* transient network error: keep polling */ }

                    if (attempts >= maxAttempts) {
                        clearInterval(timer);
                        document.getElementById('pending-text').textContent =
                            "We're still confirming your payment. Check My Orders in a minute; you won't be charged twice.";
                    }
                }, 2000);
            })();
        </script>
    }
}
