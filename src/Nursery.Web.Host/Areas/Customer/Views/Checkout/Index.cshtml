@model Nursery.Web.Host.Models.ViewModels.Checkout.CheckoutViewModel

@{
    ViewData["Title"] = "Secure Checkout";
}

<div class="container py-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-success mb-1">
                <i class="bi bi-shield-check me-2"></i>Checkout
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Catalog" asp-action="Index" class="text-decoration-none text-muted">Shop</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index" class="text-decoration-none text-muted">Cart</a></li>
                    <li class="breadcrumb-item active text-success" aria-current="page">Checkout</li>
                </ol>
            </nav>
        </div>
        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
            <i class="bi bi-arrow-left me-1"></i>Return to Cart
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <div class="fw-bold mb-1"><i class="bi bi-exclamation-octagon-fill me-2"></i>Please resolve the following errors:</div>
            <div asp-validation-summary="All" class="small mb-0"></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="PlaceOrder" method="post" id="checkoutForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdempotencyKey" />
        <input type="hidden" asp-for="CustomerId" />

        <div class="row g-4">
            <!-- Left Column: Address and Payment Info -->
            <div class="col-lg-7">
                @if (Model.Addresses != null && Model.Addresses.Any())
                {
                    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-light">
                        <div class="card-body p-3">
                            <label class="form-label small fw-bold text-secondary mb-2">
                                <i class="bi bi-bookmark-check me-1"></i>Load Saved Address
                            </label>
                            <select id="savedAddressSelector" class="form-select form-select-sm">
                                <option value="">-- Choose an address to prefill --</option>
                                @foreach (var addr in Model.Addresses)
                                {
                                    <option value='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(addr))'>
                                         @addr.Line1, @addr.State
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                }

                <!-- Billing Address Section -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="fw-bold text-dark mb-0">
                            <span class="badge bg-success rounded-circle me-2">1</span>Billing Details
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="BillingAddress.FirstName" class="form-label small fw-semibold">First Name</label>
                                <input asp-for="BillingAddress.FirstName" class="form-control" placeholder="First Name" />
                                <span asp-validation-for="BillingAddress.FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="BillingAddress.LastName" class="form-label small fw-semibold">Last Name</label>
                                <input asp-for="BillingAddress.LastName" class="form-control" placeholder="Last Name" />
                                <span asp-validation-for="BillingAddress.LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="BillingAddress.EmailAddress" class="form-label small fw-semibold">Email Address (Optional)</label>
                                <input asp-for="BillingAddress.EmailAddress" class="form-control" placeholder="example@email.com" />
                                <span asp-validation-for="BillingAddress.EmailAddress" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="BillingAddress.AddressLine" class="form-label small fw-semibold">Street Address</label>
                                <input asp-for="BillingAddress.AddressLine" class="form-control" placeholder="123 Garden Way, Apt 4" />
                                <span asp-validation-for="BillingAddress.AddressLine" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="BillingAddress.Country" class="form-label small fw-semibold">Country</label>
                                <input asp-for="BillingAddress.Country" class="form-control" placeholder="USA" />
                                <span asp-validation-for="BillingAddress.Country" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="BillingAddress.State" class="form-label small fw-semibold">State / Region</label>
                                <input asp-for="BillingAddress.State" class="form-control" placeholder="CA" />
                                <span asp-validation-for="BillingAddress.State" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="BillingAddress.ZipCode" class="form-label small fw-semibold">Postal / Zip Code</label>
                                <input asp-for="BillingAddress.ZipCode" class="form-control" placeholder="90210" />
                                <span asp-validation-for="BillingAddress.ZipCode" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Shipping Address Section -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold text-dark mb-0">
                            <span class="badge bg-success rounded-circle me-2">2</span>Shipping Address
                        </h5>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="SameAsBilling" id="sameAsBillingSwitch">
                            <label class="form-check-label small fw-semibold text-secondary" for="sameAsBillingSwitch">Same as Billing</label>
                        </div>
                    </div>
                    <div class="card-body p-4 @(Model.SameAsBilling ? "d-none" : "")" id="shippingAddressSection">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="ShippingAddress.FirstName" class="form-label small fw-semibold">First Name</label>
                                <input asp-for="ShippingAddress.FirstName" class="form-control" />
                                <span asp-validation-for="ShippingAddress.FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ShippingAddress.LastName" class="form-label small fw-semibold">Last Name</label>
                                <input asp-for="ShippingAddress.LastName" class="form-control" />
                                <span asp-validation-for="ShippingAddress.LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="ShippingAddress.EmailAddress" class="form-label small fw-semibold">Email Address (Optional)</label>
                                <input asp-for="ShippingAddress.EmailAddress" class="form-control" />
                                <span asp-validation-for="ShippingAddress.EmailAddress" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="ShippingAddress.AddressLine" class="form-label small fw-semibold">Street Address</label>
                                <input asp-for="ShippingAddress.AddressLine" class="form-control" />
                                <span asp-validation-for="ShippingAddress.AddressLine" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ShippingAddress.Country" class="form-label small fw-semibold">Country</label>
                                <input asp-for="ShippingAddress.Country" class="form-control" />
                                <span asp-validation-for="ShippingAddress.Country" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ShippingAddress.State" class="form-label small fw-semibold">State / Region</label>
                                <input asp-for="ShippingAddress.State" class="form-control" />
                                <span asp-validation-for="ShippingAddress.State" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ShippingAddress.ZipCode" class="form-label small fw-semibold">Postal / Zip Code</label>
                                <input asp-for="ShippingAddress.ZipCode" class="form-control" />
                                <span asp-validation-for="ShippingAddress.ZipCode" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Payment Method Section -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="fw-bold text-dark mb-0">
                            <span class="badge bg-success rounded-circle me-2">3</span>Payment Method
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <label class="border rounded-3 p-3 d-flex align-items-center mb-3 shadow-sm w-100 cursor-pointer">
                            <input class="form-check-input me-3 mt-0" type="radio" asp-for="PaymentMethod" value="CreditCard" checked />
                            <div class="flex-grow-1">
                                <div class="fw-bold text-dark">
                                    <i class="bi bi-credit-card-2-front text-primary me-2"></i>Pay via Stripe (Card / Apple Pay / Google Pay)
                                </div>
                                <small class="text-muted">You will be redirected securely to finalize the payment.</small>
                            </div>
                            <span class="badge bg-light text-secondary border">Encrypted</span>
                        </label>

                        <label class="border rounded-3 p-3 d-flex align-items-center shadow-sm w-100 cursor-pointer">
                            <input class="form-check-input me-3 mt-0" type="radio" asp-for="PaymentMethod" value="CashOnDelivery" />
                            <div class="flex-grow-1">
                                <div class="fw-bold text-dark">
                                    <i class="bi bi-cash-stack text-success me-2"></i>Cash on Delivery (COD)
                                </div>
                                <small class="text-muted">Pay with cash upon receipt of order.</small>
                            </div>
                        </label>
                    </div>
                </div>

            </div>

            <!-- Right Column: Line Items & Pricing Breakdown -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 2rem;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-dark mb-0">Order Summary</h5>
                        <span class="badge bg-light text-dark border">@Model.Items.Sum(x => x.Quantity) items</span>
                    </div>

                    <!-- Hidden bindings for POST submission of items collection -->
                    <div class="checkout-items-list overflow-y-auto mb-3 pe-1" style="max-height: 280px;">
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            <input type="hidden" name="Items[@i].PlantVariantId" value="@Model.Items[i].PlantVariantId" />
                            <input type="hidden" name="Items[@i].PlantName" value="@Model.Items[i].PlantName" />
                            <input type="hidden" name="Items[@i].VariantName" value="@Model.Items[i].VariantName" />
                            <input type="hidden" name="Items[@i].Sku" value="@Model.Items[i].Sku" />
                            <input type="hidden" name="Items[@i].UnitPrice" value="@Model.Items[i].UnitPrice" />
                            <input type="hidden" name="Items[@i].Quantity" value="@Model.Items[i].Quantity" />
                            <input type="hidden" name="Items[@i].ImageUrl" value="@Model.Items[i].ImageUrl" />

                            <div class="d-flex align-items-center py-2 border-bottom border-light">
                                <img src="@(string.IsNullOrEmpty(Model.Items[i].ImageUrl) ? "/images/placeholder-plant.png" : Model.Items[i].ImageUrl)"
                                     alt="@Model.Items[i].PlantName"
                                     class="rounded-3 border object-fit-cover me-3"
                                     style="width: 54px; height: 54px;" />

                                <div class="flex-grow-1 pe-2">
                                    <div class="fw-semibold text-dark text-truncate" style="max-width: 180px;">@Model.Items[i].PlantName</div>
                                    <div class="small text-muted">@Model.Items[i].VariantName &times; @Model.Items[i].Quantity</div>
                                </div>
                                <div class="fw-bold small text-dark">
                                    @Model.Items[i].TotalPrice.ToString("C")
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Cost Summaries -->
                    <div class="d-flex justify-content-between text-muted small mb-2">
                        <span>Items Subtotal</span>
                        <span>@Model.SubTotal.ToString("C")</span>
                    </div>

                    <div class="d-flex justify-content-between text-muted small mb-2">
                        <span>Shipping Fee</span>
                        <span>@Model.ShippingFee.ToString("C")</span>
                    </div>

                    <div class="d-flex justify-content-between text-muted small mb-3">
                        <span>Estimated Tax (8%)</span>
                        <span>@Model.EstimatedTax.ToString("C")</span>
                    </div>

                    <hr class="text-muted opacity-25" />

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fs-5 fw-bold text-dark">Total</span>
                        <span class="fs-4 fw-bold text-success">@Model.OrderTotal.ToString("C")</span>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-3 fw-semibold rounded-3 shadow-sm" id="btnPlaceOrder">
                        <span id="btnOrderText">Proceed with Payment</span>
                        <i class="bi bi-arrow-right ms-1"></i>
                    </button>

                    <div class="text-center mt-3">
                        <span class="text-muted small">
                            <i class="bi bi-shield-lock-fill text-success me-1"></i>Guaranteed Fresh & Secure Delivery
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const sameAsBillingSwitch = document.getElementById('sameAsBillingSwitch');
            const shippingSection = document.getElementById('shippingAddressSection');
            const paymentRadios = document.querySelectorAll('input[name="PaymentMethod"]');
            const submitBtnText = document.getElementById('btnOrderText');
            const addressSelector = document.getElementById('savedAddressSelector');

            // 1. Toggle Shipping Address Section
            if (sameAsBillingSwitch && shippingSection) {
                sameAsBillingSwitch.addEventListener('change', (e) => {
                    if (e.target.checked) {
                        shippingSection.classList.add('d-none');
                    } else {
                        shippingSection.classList.remove('d-none');
                    }
                });
            }

            // 2. Adjust button CTA based on payment selection
            paymentRadios.forEach(radio => {
                radio.addEventListener('change', (e) => {
                    if (e.target.value === 'CashOnDelivery') {
                        submitBtnText.textContent = 'Confirm Order (COD)';
                    } else {
                        submitBtnText.textContent = 'Proceed with Payment';
                    }
                });
            });

            // 3. Pre-fill Billing Address from saved list
            if (addressSelector) {
                addressSelector.addEventListener('change', (e) => {
                    if (!e.target.value) return;
                    try {
                        const addr = JSON.parse(e.target.value);
                        document.querySelector('input[name="BillingAddress.FirstName"]').value = addr.FirstName || addr.firstName || 'Manikandan';
                        document.querySelector('input[name="BillingAddress.LastName"]').value = addr.LastName || addr.lastName || 'Rajamani';
                        document.querySelector('input[name="BillingAddress.EmailAddress"]').value = addr.EmailAddress || addr.emailAddress || 'rajmani.manikandan@hotmail.com';
                        document.querySelector('input[name="BillingAddress.AddressLine"]').value = addr.Line1 || addr.addressLine || '';
                        document.querySelector('input[name="BillingAddress.Country"]').value = addr.Country || addr.country || '';
                        document.querySelector('input[name="BillingAddress.State"]').value = addr.State || addr.state || '';
                        document.querySelector('input[name="BillingAddress.ZipCode"]').value = addr.PostalCode || addr.PostalCode || '';
                    } catch (err) {
                        console.error('Failed to parse saved address:', err);
                    }
                });
            }
        });
    </script>
}