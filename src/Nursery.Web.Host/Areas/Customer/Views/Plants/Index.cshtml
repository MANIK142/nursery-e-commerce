
@{
    ViewData["Title"] = "Plants";
}
@model List<Nursery.Web.Host.Models.ViewModels.PlantCardViewModel>
@* <div class="container mt-5"> *@
    <h1>Plants</h1>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var plant in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <img src="@(plant.ImageUrl ?? "/images/placeholder.png")" class="card-img-top" alt="@plant.Name" />
                    <div class="card-body">
                        <h5 class="card-title">@plant.Name</h5>
                        <p class="text-muted mb-1">@plant.Categories</p>
                        @if (plant.SalePrice is not null)
                        {
                            <p><s>@plant.Currency @plant.DisplayPrice</s> <strong class="text-danger">@plant.Currency @plant.SalePrice</strong></p>
                        }
                        else
                        {
                            <p><strong>@plant.Currency @plant.DisplayPrice</strong></p>
                        }
                        <a asp-action="Details" asp-route-id="@plant.Id" class="btn btn-primary">View</a>
                    </div>
                </div>
            </div>
        }
    </div>
@* </div> *@
