@model Nursery.Web.Host.ViewModels.PlantCardViewModel
@* <div class="container mt-5"> *@
<div class="row">
    <div class="col-md-6">
        @if (Model.ImageUrl != null)
        {
            <img src="@Model.ImageUrl" class="img-fluid" alt="@Model.Name" />
        }
    </div>
    <div class="col-md-6">
        <h1>@Model.Name</h1>
        <p class="text-muted">@Model.Categories</p>
        <h3>₹@Model.DisplayPrice</h3>
        <p>@Model.Name</p>
        <h5>Care Instructions</h5>
        <a asp-action="Index" class="btn btn-secondary">Back to Plants</a>
    </div>
</div>
@* </div> *@