@model Nursery.Web.Host.Models.ViewModels.Plants.CreatePlantViewModel
@{
    ViewData["Title"] = "Create Plant";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h2 class="text-success fw-bold mb-0">Create Plant</h2>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>

            <form asp-action="Upsert" method="post" id="createPlantForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Basic Plant Info -->
                <div class="card mb-4 shadow-sm border-0">
                    <div class="card-header bg-white border-bottom">
                        <h5 class="mb-0">General Details</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3 mb-3">
                            <div class="col-md">
                                <label asp-for="Name" class="form-label fw-semibold">Plant Name</label>
                                <input asp-for="Name" class="form-control" placeholder="e.g., Monstera Deliciosa" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="CreatedBy" class="form-label fw-semibold">Created By</label>
                                <input asp-for="CreatedBy" class="form-control" placeholder="Author/Admin username" />
                                <span asp-validation-for="CreatedBy" class="text-danger small"></span>
                            </div>
                        </div>a

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Care details, humidity requirements, soil info..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div>
                            <label class="form-label fw-semibold">Categories</label>
                            <select asp-for="SelectedCategories" asp-items="Model.AvailableCategories" class="form-select" multiple size="4">
                            </select>
                            <div class="form-text">Hold Ctrl (or Cmd on Mac) to select multiple categories.</div>
                            <span asp-validation-for="SelectedCategories" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Base Plant Images -->
                <div class="card mb-4 shadow-sm border-0">
                    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0">Base Plant Images</h5>
                            <small class="text-muted">Images are automatically uploaded upon selection.</small>
                        </div>
                        <button type="button" class="btn btn-outline-success btn-sm" id="addPlantImageBtn">+ Add Base Image</button>
                    </div>
                    <div class="card-body" id="plantImagesContainer">
                        @for (int i = 0; i < Model.Images.Count; i++)
                        {
                            @await Html.PartialAsync("Partials/_ImageRowPartial", Model.Images[i], new ViewDataDictionary(ViewData)
                            {
                                { "Index", i },
                                { "Prefix", "Images" }
                            })
                        }
                    </div>
                </div>

                <!-- Plant Variants -->
                <div class="card mb-4 shadow-sm border-0">
                    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Plant Variants & Pricing</h5>
                        <button type="button" class="btn btn-success btn-sm" id="addVariantBtn">+ Add Variant</button>
                    </div>
                    <div class="card-body" id="variantsContainer">
                        @for (int i = 0; i < Model.PlantVariantSpecs.Count; i++)
                        {
                            @await Html.PartialAsync("Partials/_VariantRowPartial", Model.PlantVariantSpecs[i], new ViewDataDictionary(ViewData)
                            {
                                { "Index", i }
                            })
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pb-5">
                    <button type="submit" id="submitBtn" class="btn btn-success px-4">Save & Publish Plant</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Raw Dynamic Templates -->
<template id="plantImageTemplate">
    <div class="card mb-2 bg-light border-0 image-spec-item" data-index="__IMG_IDX__">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <label class="form-label small text-muted mb-1">Image File</label>
                    <div class="input-group input-group-sm">
                        <input type="file" class="form-control image-file-input" accept="image/*" required />
                        <span class="input-group-text upload-status d-none">
                            <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                        </span>
                    </div>
                    <input type="hidden" name="__PREFIX__[__IMG_IDX__].StorageKey" class="storage-key-input" required />
                    <span class="storage-key-display badge bg-secondary text-truncate mt-1 d-block d-none" style="max-width: 100%;"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label small text-muted mb-1">Alt Text</label>
                    <input type="text" name="__PREFIX__[__IMG_IDX__].AltText" class="form-control form-control-sm" placeholder="e.g., Side view" />
                </div>
                <div class="col-md-2 d-flex align-items-center pt-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="__PREFIX__[__IMG_IDX__].IsPrimaryImage" value="true" />
                        <input type="hidden" name="__PREFIX__[__IMG_IDX__].IsPrimaryImage" value="false" />
                        <label class="form-check-label small">Primary</label>
                    </div>
                </div>
                <div class="col-md-1 text-end pt-3">
                    <button type="button" class="btn btn-outline-danger btn-sm remove-row-btn" title="Remove Image">&times;</button>
                </div>
            </div>
        </div>
    </div>
</template>

<template id="variantTemplate">
    <div class="card mb-3 border variant-card" data-index="__VAR_IDX__">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
            <span class="fw-semibold text-secondary">Variant #<span class="variant-display-idx">__DISPLAY_IDX__</span></span>
            <button type="button" class="btn btn-outline-danger btn-sm remove-variant-btn">Remove Variant</button>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Variant Name</label>
                    <input type="text" name="PlantVariantSpecs[__VAR_IDX__].VariantName" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold">SKU</label>
                    <input type="text" name="PlantVariantSpecs[__VAR_IDX__].Sku" class="form-control" required />
                </div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Retail Price</label>
                    <input type="number" step="0.01" name="PlantVariantSpecs[__VAR_IDX__].RetailPrice.Amount" value="1.00" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Retail Currency</label>
                    <input type="text" name="PlantVariantSpecs[__VAR_IDX__].RetailPrice.Currency" value="USD" class="form-control" maxlength="3" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Wholesale Price</label>
                    <input type="number" step="0.01" name="PlantVariantSpecs[__VAR_IDX__].WholesalePrice.Amount" value="1.00" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Wholesale Currency</label>
                    <input type="text" name="PlantVariantSpecs[__VAR_IDX__].WholesalePrice.Currency" value="USD" class="form-control" maxlength="3" required />
                </div>
            </div>
            <div class="border-top pt-2">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small fw-bold text-muted">Variant Images</span>
                    <button type="button" class="btn btn-outline-secondary btn-sm add-variant-image-btn" data-variant-prefix="PlantVariantSpecs[__VAR_IDX__]">
                        + Add Variant Image
                    </button>
                </div>
                <div class="variant-image-container"></div>
            </div>
        </div>
    </div>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/plant-create.js" asp-append-version="true"></script>
}