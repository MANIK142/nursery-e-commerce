@model Nursery.Web.Host.Models.ViewModels.Plants.SalePriceModel
@{
    var vIndex = ViewData["Index"]?.ToString() ?? "0";
    var prefix = $"PlantVariantSpecs[0].SalePrices[{vIndex}]";

}


<div class="card mb-3 border sale-price-item" data-index="@vIndex">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
        <span class="fw-semibold text-secondary">Sale #<span class="sale-display-idx">@(Convert.ToInt32(vIndex) + 1)</span></span>
        <button type="button" class="btn btn-outline-danger btn-sm remove-sale-btn">Remove Sale</button>
    </div>
    <div class="card-body">
        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <label class="form-label small fw-bold">Sale Price</label>
                <input type="number" step="0.01" name="@(prefix).SalePrice.Amount" value="@Model.SalePrice.Amount" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Sale Currency</label>
                <input type="text" name="@(prefix).SalePrice.Currency" value="@(string.IsNullOrEmpty(Model.SalePrice.Currency) ? "INR" : Model.SalePrice.Currency)" class="form-control" maxlength="3" required />
            </div>
        @* </div>

        <div class="row g-3 mb-3"> *@
            <div class="col-md-3">
                <label class="form-label small fw-bold">Sale Start Time</label>
                <input type="datetime-local" name="@(prefix).StartsAtUtc" value="@(Model.StartsAtUtc.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Sale End Time</label>
                <input type="datetime-local" name="@(prefix).EndsAtUtc" value="@(Model.EndsAtUtc.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" required />
            </div>
        </div>


    </div>
</div>