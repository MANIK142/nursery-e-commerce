@model Nursery.Web.Host.Models.ViewModels.Plants.PlantImageInputModel
@{
    var index = ViewData["Index"]?.ToString() ?? "0";
    var prefix = ViewData["Prefix"]?.ToString() ?? "Images";
    var fieldPrefix = $"{prefix}[{index}]";
    var hasKey = !string.IsNullOrEmpty(Model.StorageKey);
}

<div class="card mb-2 bg-light border-0 image-spec-item" data-index="@index">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <!-- File Picker & Hidden Key -->
            <div class="col-md-5">
                <label class="form-label small text-muted mb-1">Image File</label>
                <div class="input-group input-group-sm">
                    <input type="file" class="form-control image-file-input" accept="image/*" />
                    <span class="input-group-text upload-status d-none">
                        <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                    </span>
                </div>
                <!-- Model Binder stores the key returned by the API -->
                <input type="hidden" name="@(fieldPrefix).StorageKey" value="@Model.StorageKey" class="storage-key-input" required />
                <span class="storage-key-display badge bg-secondary text-truncate mt-1 d-block @(hasKey ? "" : "d-none")" style="max-width: 100%;">
                    Key: @(Model.StorageKey)
                </span>
            </div>

            <!-- Alt Text -->
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Alt Text</label>
                <input type="text" name="@(fieldPrefix).AltText" value="@Model.AltText" class="form-control form-control-sm" placeholder="e.g., Broad leaf close up" />
            </div>

            <!-- Primary Flag -->
            <div class="col-md-2 d-flex align-items-center pt-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="@(fieldPrefix).IsPrimaryImage" value="true" @(Model.IsPrimaryImage ? "checked" : "") />
                    <input type="hidden" name="@(fieldPrefix).IsPrimaryImage" value="false" />
                    <label class="form-check-label small">Primary</label>
                </div>
            </div>

            <!-- Remove Row -->
            <div class="col-md-1 text-end pt-3">
                <button type="button" class="btn btn-outline-danger btn-sm remove-row-btn" title="Remove Image">&times;</button>
            </div>
        </div>
    </div>
</div>