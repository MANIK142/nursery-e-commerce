@model Nursery.Web.Host.Models.ViewModels.Plants.PlantVariantInputModel
@{
    var vIndex = ViewData["Index"]?.ToString() ?? "0";
    var prefix = $"PlantVariantSpecs[{vIndex}]";
}

<div class="card mb-3 border variant-card" data-index="@vIndex">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
        <span class="fw-semibold text-secondary">Variant #<span class="variant-display-idx">#@(Convert.ToInt32(vIndex) + 1)</span></span>
        <button type="button" class="btn btn-outline-danger btn-sm remove-variant-btn">Remove Variant</button>
    </div>
    <div class="card-body">
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label small fw-bold">Variant Name</label>
                <input type="text" name="@(prefix).VariantName" value="@Model.VariantName" class="form-control" placeholder="e.g., 6-inch Pot / Variegated" required />
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-bold">SKU</label>
                <input type="text" name="@(prefix).Sku" value="@Model.Sku" class="form-control" placeholder="e.g., MON-VAR-06" required />
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <label class="form-label small fw-bold">Retail Price</label>
                <input type="number" step="0.01" name="@(prefix).RetailPrice.Amount" value="@Model.RetailPrice.Amount" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Retail Currency</label>
                <input type="text" name="@(prefix).RetailPrice.Currency" value="@(string.IsNullOrEmpty(Model.RetailPrice.Currency) ? "USD" : Model.RetailPrice.Currency)" class="form-control" maxlength="3" required />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Wholesale Price</label>
                <input type="number" step="0.01" name="@(prefix).WholesalePrice.Amount" value="@Model.WholesalePrice.Amount" class="form-control" required />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Wholesale Currency</label>
                <input type="text" name="@(prefix).WholesalePrice.Currency" value="@(string.IsNullOrEmpty(Model.WholesalePrice.Currency) ? "USD" : Model.WholesalePrice.Currency)" class="form-control" maxlength="3" required />
            </div>
        </div>

        <div class="border-top pt-2">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small fw-bold text-muted">Variant Images</span>
                <button type="button" class="btn btn-outline-secondary btn-sm add-variant-image-btn" data-variant-prefix="@prefix">
                    + Add Variant Image
                </button>
            </div>
            <div class="variant-image-container">
                @for (int j = 0; j < Model.ImageSpecs.Count; j++)
                {
                    var rowViewData = new ViewDataDictionary(ViewData);
                    rowViewData["Index"] = j;
                    rowViewData["Prefix"] = $"{prefix}.ImageSpecs";
                    @await Html.PartialAsync("Partials/_ImageRowPartial", Model.ImageSpecs[j], rowViewData)

                }
            </div>
        </div>

        <div class="border-top pt-2">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small fw-bold text-muted">Sale Prices</span>
                <button type="button" class="btn btn-outline-secondary btn-sm add-Sale-btn" data-variant-prefix="@prefix">
                    + Add Sale
                </button>
            </div>
            <div class="sale-price-container">
                @for (int j = 0; j < Model.SalePrices.Count; j++)
                {
                    var rowViewData = new ViewDataDictionary(ViewData);
                    rowViewData["Index"] = j;
                    rowViewData["Prefix"] = $"{prefix}.SalePrices";
                    @await Html.PartialAsync("Partials/_SalePricePartial", Model.SalePrices[j], rowViewData)

                }
            </div>
        </div>
    </div>
</div>