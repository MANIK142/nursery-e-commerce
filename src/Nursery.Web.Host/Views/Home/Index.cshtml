@{
    ViewData["Title"] = "Home Page";
}
<div class="container-fluid">
    <section class="hero-section">
        <div class="hero-overlay"></div>
        <div class="container-fluid hero-content">
            <div class="hero-text">
                <h1>
                    Largest gardening store in
                    <span>Tamiil Nadu</span>
                    <span>For Native Plants</span>
                </h1>
                <p>
                 6000+ live plants — handpicked from local growers.

                <div class="hero-buttons">
                    <a href="#" class="btn btn-shop">
                        Shop Plants
                    </a>
                </div>
            </div>
        </div>
    </section>

    <div class="container mt-lg-5">
        <div class="row">
                <div class="col d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="bi bi-rulers fs-1"></i>
                    <h4>Fully-Grown Plants</h4>
                    <h6>Nursery-mature, not 4-inch saplings</h6>
                </div>

                <div class="col d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="bi bi-hand-thumbs-up fs-1"></i>
                    <h4>Nursery-Fresh</h4>
                    <h6>Ready to flourish, no growing-in</h6>
                </div>

                <div class="col d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="bi bi-airplane-engines fs-1"></i>
                    <h4>Next-Day Delivery</h4>
                    <h6>At your door tomorrow — not a 4–7 day wait</h6>
                </div>

                <div class="col d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="bi bi-tags fs-1"></i>
                    <h4>Lowest Prices</h4>
                    <h6>Direct Nursery Delivery</h6>
                </div>
        </div>
    </div>



</div>
