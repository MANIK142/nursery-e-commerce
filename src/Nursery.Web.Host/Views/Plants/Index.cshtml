@model Nursery.Web.Host.Models.Catalog.PagedResult<Nursery.Web.Host.Models.Catalog.PlantSummaryDto>

<h1>Plants</h1>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var plant in Model.Items)
    {
        <div class="col">
            <div class="card h-100">
                <img src="@(plant.ThumbnailUrl ?? "/images/placeholder.png")" class="card-img-top" alt="@plant.Name" />
                <div class="card-body">
                    <h5 class="card-title">@plant.Name</h5>
                    <p class="card-text">@plant.Category — ₹@plant.Price</p>
                    <a asp-action="Details" asp-route-id="@plant.Id" class="btn btn-primary">View</a>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.TotalCount > Model.PageSize)
{
    <nav class="mt-4">
        <ul class="pagination">
            @for (int p = 1; p <= Math.Ceiling((double)Model.TotalCount / Model.PageSize); p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}